{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "statework.snapshot"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "exportedAt": {
      "type": "string"
    },
    "state": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "workspace": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "createdAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "revision",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "items": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "task",
                  "project",
                  "note",
                  "event"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "description": {
                "type": "string",
                "maxLength": 20000
              },
              "status": {
                "type": "string",
                "enum": [
                  "inbox",
                  "ready",
                  "active",
                  "done",
                  "cancelled"
                ]
              },
              "priority": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  }
                ]
              },
              "tags": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              },
              "effortMinutes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 525600
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dueDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "schedule": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "string"
                      },
                      "end": {
                        "type": "string"
                      },
                      "timeZone": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "start",
                      "end",
                      "timeZone"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "extensions": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 120,
                  "pattern": "^[a-z][a-z0-9.-]*\\/[a-zA-Z0-9._-]+$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "archived": {
                "type": "boolean"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "description",
              "status",
              "priority",
              "tags",
              "effortMinutes",
              "dueDate",
              "schedule",
              "extensions",
              "archived",
              "version",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        },
        "relations": {
          "maxItems": 30000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "depends_on",
                  "contains",
                  "relates_to"
                ]
              },
              "from": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              }
            },
            "required": [
              "id",
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "views": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "query": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "statuses": {
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "inbox",
                        "ready",
                        "active",
                        "done",
                        "cancelled"
                      ]
                    }
                  },
                  "kinds": {
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "task",
                        "project",
                        "note",
                        "event"
                      ]
                    }
                  },
                  "tags": {
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 60
                    }
                  },
                  "parentId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "actionable": {
                    "type": "boolean"
                  },
                  "scheduled": {
                    "type": "boolean"
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "dueBefore": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "sort": {
                    "type": "string",
                    "enum": [
                      "priority",
                      "due",
                      "updated",
                      "title"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "renderer": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._/-]{0,79}$"
              }
            },
            "required": [
              "id",
              "title",
              "query",
              "renderer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "workspace",
        "items",
        "relations",
        "views"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "formatVersion",
    "exportedAt",
    "state"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
