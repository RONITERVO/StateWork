{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "output": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9./-]{0,79}$"
      }
    },
    "input": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9./-]{0,79}$"
      }
    },
    "detail": {
      "type": "string",
      "enum": [
        "brief",
        "standard",
        "expanded"
      ]
    },
    "motion": {
      "type": "string",
      "enum": [
        "none",
        "reduced",
        "full"
      ]
    },
    "contrast": {
      "type": "string",
      "enum": [
        "standard",
        "high"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "maxItems": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "textScale": {
      "default": 1,
      "type": "number",
      "minimum": 1,
      "maximum": 2
    }
  },
  "required": [
    "schemaVersion",
    "output",
    "input",
    "detail",
    "motion",
    "contrast",
    "language",
    "timeZone",
    "maxItems"
  ],
  "additionalProperties": false
}
