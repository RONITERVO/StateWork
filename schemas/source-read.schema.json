{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "statework.source-read"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "taskIds": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "kind": {
          "type": "string",
          "enum": [
            "page",
            "file",
            "email",
            "note"
          ]
        },
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "excerpt",
            "unreadable"
          ]
        },
        "replaces": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "capturedAt": {
          "type": "string"
        },
        "capturedBy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        }
      },
      "required": [
        "id",
        "taskIds",
        "title",
        "locator",
        "kind",
        "coverage",
        "replaces",
        "capturedAt",
        "capturedBy"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "superseded",
            "historical",
            "needs-check",
            "verified"
          ]
        },
        "capturedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "validUntil": {
          "type": [
            "string",
            "null"
          ]
        },
        "verificationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "capturedAt",
        "observedAt",
        "validUntil",
        "verificationId"
      ],
      "additionalProperties": false
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextOffset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "type": "string",
      "maxLength": 16000
    }
  },
  "required": [
    "format",
    "formatVersion",
    "workspaceId",
    "revision",
    "source",
    "freshness",
    "offset",
    "total",
    "nextOffset",
    "content"
  ],
  "additionalProperties": false
}
