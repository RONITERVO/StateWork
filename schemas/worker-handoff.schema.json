                  "at": {
                    "type": "string"
                  },
                  "by": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  }
                },
                "required": [
                  "requirementId",
                  "available",
                  "evidence",
                  "at",
                  "by"
