        "status": {
          "type": "string",
          "enum": [
            "inbox",
            "ready",
            "active",
            "done",
            "cancelled"
          ]
        },
        "priority": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            }
          ]
