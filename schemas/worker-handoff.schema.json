                      "options": {
                        "minItems": 2,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240
                            }
