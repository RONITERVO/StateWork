{
  "name": "statework",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13 <26"
  },
  "scripts": {
    "build:lib": "tsc -b packages/core packages/sdk packages/node packages/server packages/tools",
    "build": "npm run build:lib && node scripts/contracts.mjs && npm run build -w @statework/reference",
    "typecheck": "npm run build:lib && tsc -p packages/reference/tsconfig.json --noEmit",
    "test": "npm run build:lib && vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run lint && npm run build",
    "lint": "node scripts/boundaries.mjs && prettier --check packages tests scripts examples *.json *.ts",
    "format": "prettier --write packages tests scripts examples *.json *.ts",
    "start": "node packages/server/dist/main.js",
    "dev": "npm run build && npm start",
    "cli": "node packages/tools/dist/cli.js",
    "mcp": "node packages/tools/dist/mcp.js",
    "demo": "node examples/headless.mjs",
    "benchmark": "npm run build:lib && node scripts/benchmark.mjs",
    "contracts": "npm run build:lib && node scripts/contracts.mjs",
    "notices": "node scripts/notices.mjs",
    "release:local": "npm run check && node scripts/release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "iwer": "2.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
